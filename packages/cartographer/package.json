{
  "name": "@cartographer/core",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence recorder, site graph compiler, and CLI emitter for deterministic browser workflows.",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cartographer": "./dist/cli.js",
    "cg": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run typecheck",
    "test": "pnpm build && node --test dist/explorer/*.test.js"
  },
  "dependencies": {
    "mdream": "^1.2.2",
    "playwright": "^1.52.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.4",
    "typescript": "5.8.3"
  }
}
